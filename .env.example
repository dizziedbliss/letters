# Copy to .env for local dev; on Vercel add these under Project > Settings > Environment Variables
ADMIN_PASSWORD=change-me
# The code she types on the landing page (server-checked, not in the frontend bundle)
READER_CODE=dreams
SESSION_SECRET=long-random-string
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server only, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
