# Public by design (safe in the browser). Same names go in Vercel > Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The two accounts' emails, comma-separated. The landing field tries each with the typed code.
VITE_ACCOUNT_EMAILS=you@example.com,her@example.com
